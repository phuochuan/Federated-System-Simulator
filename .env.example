# Example values for IDE environment settings. Spring/PowerShell do not auto-load this file.
# Start Python first: .\.venv\Scripts\python -m uvicorn minifls.api:app --workers 1
MINIFLS_WORKSPACE=D:/research/federated-system
MINIFLS_WORKER_URL=http://127.0.0.1:8000
MINIFLS_DATABASE=D:/research/federated-system/artifacts/minifls.db
MINIFLS_SERVER_PORT=8080
MINIFLS_TORCH_THREADS=1
# INFO: lifecycle, epochs and metrics. DEBUG: HTTP timing, batch progress, class metrics, checkpoints.
# Set in both Java and Python environments; restart each process to apply.
MINIFLS_LOG_LEVEL=INFO
# Set in the PYTHON worker environment before startup; only affects new initializations.
# Legacy baseline: mlp_54_128_64_7
MINIFLS_MODEL_ARCHITECTURE=mlp_54_256_128_7

# Set MINIFLS_LAUNCH_ENABLED=false for API-only startup.
# With launch enabled, use explicit F/L/research modes; inspect ApplicationRunner's manual fallback.
# The historical matrix/fedavg/fedlbw dispatch is currently commented out in ApplicationRunner.
# lambda_ablation = L0-L5 fixed/adaptive lambda batch.
MINIFLS_METHOD=none
MINIFLS_CONFIG=configurations/fedavg.json
# Empty ID generates a new UUID-based ID. Fixed IDs cannot be reused for a new run.
MINIFLS_EXPERIMENT_ID=
# Empty overrides retain the JSON config values.
MINIFLS_MANIFEST=
MINIFLS_SELECTION=
MINIFLS_ROUNDS=
MINIFLS_SEED=

# Used by MINIFLS_METHOD=matrix after enabling the desired ApplicationRunner calls.
# A/B/C together: 9 rows x 5 seeds; compareClientSelection alone: 5 rows x 5 seeds.
# Round count comes from baseConfig.rounds in the matrix JSON.
MINIFLS_MATRIX_CONFIG=configurations/controlled-matrix.json
# Used by MINIFLS_METHOD=fuzzy_matrix: F1-F5 x 5 seeds = 25 experiments, 70 rounds each.
MINIFLS_FUZZY_MATRIX_CONFIG=configurations/fuzzy-matrix.json
# MINIFLS_METHOD=lambda_ablation: L0-L5 x 5 seeds = 30 experiments, 70 rounds each.
MINIFLS_LAMBDA_MATRIX_CONFIG=configurations/lambda-ablation.json
# Optional round override for matrix, fuzzy_matrix AND lambda_ablation; e.g. 2 for smoke.
# Leave empty for the protocol's configured round count.
MINIFLS_MATRIX_ROUNDS=
# Java research modes: reproducibility_audit / fairness_matched_validation / fairness_matched_evaluation
# MINIFLS_AUDIT_CONFIG=configurations/reproducibility-audit.json
# MINIFLS_MATCHED_CONFIG=configurations/fairness-matched-lambda.json
# MINIFLS_RESEARCH_OUTPUT=artifacts/research/fairness-matched
# Worker retry: total 4 attempts; waits 2s, 4s, 8s; timeout per attempt stays 30min.
# MINIFLS_WORKER_MAX_ATTEMPTS=4
# MINIFLS_WORKER_RETRY_DELAY_MS=2000
# MINIFLS_WORKER_RETRY_MAX_DELAY_MS=30000
# MINIFLS_WORKER_REQUEST_TIMEOUT_SECONDS=1800
# MINIFLS_LAUNCH_ENABLED=false disables startup experiments for API-only checks.
# Optional distinct roots when ApplicationRunner calls E0 -> Phase A -> Phase B directly:
# MINIFLS_AUDIT_OUTPUT=artifacts/research/new-batch/e0
# MINIFLS_MATCHED_OUTPUT=artifacts/research/new-batch/e1
# Held-out Pareto: explicit mode skips the manual E0/Phase A/matched evaluation sequence.
# MINIFLS_METHOD=pareto_preflight
# MINIFLS_METHOD=heldout_pareto
# MINIFLS_PARETO_CONFIG=configurations/pareto-tradeoff.json
# MINIFLS_PARETO_OUTPUT=artifacts/research/pareto-tradeoff
