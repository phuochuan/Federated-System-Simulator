# Example values for IDE environment settings. Spring/PowerShell do not auto-load this file.
# Start Python first: .\.venv\Scripts\python -m uvicorn minifls.api:app --workers 1
MINIFLS_WORKSPACE=D:/research/federated-system
MINIFLS_WORKER_URL=http://127.0.0.1:8000
MINIFLS_DATABASE=D:/research/federated-system/artifacts/minifls.db
MINIFLS_SERVER_PORT=8080
MINIFLS_TORCH_THREADS=1
# INFO: lifecycle, epochs and metrics. DEBUG: HTTP timing, batch progress, class metrics, checkpoints.
# Set in both Java and Python environments; restart each process to apply.
MINIFLS_LOG_LEVEL=INFO
# Set in the PYTHON worker environment before startup; only affects new initializations.
# Legacy baseline: mlp_54_128_64_7
MINIFLS_MODEL_ARCHITECTURE=mlp_54_256_128_7

# none = API only; fedavg/fedlbw = one experiment; fuzzy_matrix = F1-F5 batch.
# matrix = enabled A/B/C calls in ApplicationRunner (currently all commented out).
MINIFLS_METHOD=none
MINIFLS_CONFIG=configurations/fedavg.json
# Empty ID generates a new UUID-based ID. Fixed IDs cannot be reused for a new run.
MINIFLS_EXPERIMENT_ID=
# Empty overrides retain the JSON config values.
MINIFLS_MANIFEST=
MINIFLS_SELECTION=
MINIFLS_ROUNDS=
MINIFLS_SEED=

# Used by MINIFLS_METHOD=matrix after enabling the desired ApplicationRunner calls.
# A/B/C together: 9 rows x 5 seeds; compareClientSelection alone: 5 rows x 5 seeds.
# Round count comes from baseConfig.rounds in the matrix JSON.
MINIFLS_MATRIX_CONFIG=configurations/controlled-matrix.json
# Used by MINIFLS_METHOD=fuzzy_matrix: F1-F5 x 5 seeds = 25 experiments, 70 rounds each.
MINIFLS_FUZZY_MATRIX_CONFIG=configurations/fuzzy-matrix.json
# Optional round override for BOTH matrix modes; e.g. 2 for a smoke test.
# Leave empty for the protocol's configured round count.
MINIFLS_MATRIX_ROUNDS=
